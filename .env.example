# ==============================================================================
# CLOUD-BASED STUDENT ASSIGNMENT SUBMISSION & FEEDBACK PORTAL
# Environment Configuration Template
# ==============================================================================

# Application URL (injected by Cloud Run / Firebase Hosting)
VITE_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# FIREBASE CLIENT CONFIGURATION (Safe for Client-Side Frontend)
# Obtain these from Firebase Console -> Project Settings -> General -> Your Apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyDummyKeyForLocalTestingPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="student-assignment-portal.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="student-assignment-portal"
VITE_FIREBASE_STORAGE_BUCKET="student-assignment-portal.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# LOCAL FIREBASE EMULATOR CONFIGURATION (Optional - for offline testing)
# Set to 'true' to connect to local Firebase Emulators (Auth 9099, Firestore 8080)
# ------------------------------------------------------------------------------
VITE_USE_FIREBASE_EMULATOR="false"
VITE_EMULATOR_HOST="localhost"

# ------------------------------------------------------------------------------
# SERVER-SIDE SECRETS (NEVER EXPOSE IN FRONTEND CODE OR VITE_ VARS)
# Keep in Google Cloud Secret Manager / Cloud Run Environment
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_SERVICE_ACCOUNT_KEY=""
GEMINI_API_KEY=""
