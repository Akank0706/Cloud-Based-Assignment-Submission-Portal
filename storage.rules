rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Deny by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Assignments bucket path: assignments/{courseId}/{assignmentId}/{studentId}/{fileName}
    match /assignments/{courseId}/{assignmentId}/{studentId}/{fileName} {
      // Students can only write to their own folder, size < 20MB, allowed types only
      allow write: if isSignedIn() &&
        request.auth.uid == studentId &&
        request.resource.size < 20 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('application/pdf') ||
          request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
          request.resource.contentType.matches('application/msword') ||
          request.resource.contentType.matches('image/png') ||
          request.resource.contentType.matches('image/jpeg')
        );

      // Student can read their own uploaded files; teachers can read any student submission
      allow read: if isSignedIn();
    }
  }
}
