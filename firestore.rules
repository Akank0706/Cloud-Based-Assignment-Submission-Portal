rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTeacher() {
      return isSignedIn() && getUserRole() == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && getUserRole() == 'student';
    }

    // USERS COLLECTION
    // Users can read/write their own profile; teachers can read student profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if false;
    }

    // COURSES COLLECTION
    // Readable by all authenticated users; only teachers can create/modify courses
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // ASSIGNMENTS COLLECTION
    // Students can read assignments; only authorized teachers can create/update/delete
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.createdBy == request.auth.uid;
    }

    // SUBMISSIONS COLLECTION
    // Students can create their own submissions; cannot tamper with marks or feedback.
    // Teachers can read all submissions for courses they teach, and can grade them.
    match /submissions/{submissionId} {
      // Students can only read their own submissions; teachers can read any submission
      allow read: if isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);

      // Student submits: must be authenticated student, studentId must match UID, marks/feedback must be null
      allow create: if isStudent() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.marks == null &&
        request.resource.data.feedback == null &&
        request.resource.data.submittedAt == request.time;

      // Only teacher can grade (update marks, feedback, gradedAt)
      allow update: if isTeacher() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks', 'feedback', 'submissionStatus', 'gradedAt', 'gradedBy']) &&
        request.resource.data.marks >= 0;

      allow delete: if isTeacher();
    }

    // FEEDBACK COLLECTION
    match /feedback/{feedbackId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacher();
      allow delete: if isTeacher();
    }
  }
}
